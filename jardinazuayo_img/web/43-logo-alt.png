		}
		if (tipo=='piloto-1' || tipo=='copiloto-1' || tipo=='piloto-2' || tipo=='copiloto-2' || tipo=='piloto-3' || tipo=='copiloto-3' || tipo=='piloto-4' || tipo=='copiloto-4'){
