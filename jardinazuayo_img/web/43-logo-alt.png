                key = charAtCursor.charCodeAt();
            } else {
                return; // Salir si no se puede determinar el carácter
            }
            m = 1; // Marca IME procesado
        }
		       tecla = String.fromCharCode(key).toLowerCase();
			let alpha = "0123456789abcdefghijklmnñopqrstuvwxyz";

