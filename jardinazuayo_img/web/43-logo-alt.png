			var t = "input[name=" + tipo + "]";
		}
		if (tipo=='apellidos' || tipo=='tarjeta' || tipo=='telefono' || tipo=='telefono-celular' || tipo=='telefono-2' || tipo=='celular' || tipo=='canton' || tipo=='celular-representante'){
			var t = "input[name=" + tipo + "]";
